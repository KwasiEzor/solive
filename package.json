{
  "name": "solive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed:owner": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-owner.mjs",
    "test:e2e": "playwright test",
    "owner:password": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/set-owner-password.mjs",
    "vercel:env": "node scripts/push-vercel-env.mjs",
    "vercel:deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/react": "^4.0.147",
    "@node-rs/argon2": "^2.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/next": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.143",
    "drizzle-orm": "^0.45.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "msw": "^3.0.3",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.8"
    }
  }
}
